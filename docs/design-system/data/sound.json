 "rules": [
  {
   "rule": "Silent until touched",
   "detail": "The AudioContext is created suspended and resumed on the first pointerdown or keydown. Nothing autoplays, ever, including after a reload."
  },
  {
   "rule": "Low by default",
   "detail": "Master gain starts at 0.25 (about −12 dB). No sound peaks above −18 dBFS. Volume lives in Settings; the header toggle is on/off."
  },
  {
   "rule": "Plays nice with music",
   "detail": "On iPhone, navigator.audioSession.type = \"ambient\": respects the silent switch and mixes under whatever is already playing."
  },
  {
   "rule": "Never a pile-up",
   "detail": "At most 6 voices. Ticks within 30ms of each other merge; the pour cascade thins out after 24 voices."
  },
  {
   "rule": "Motion and sound are separate",
   "detail": "Reduced motion does not mute. Sound off does not change motion. Both settings persist."
  },
  {
   "rule": "Haptics as a quiet echo",
   "detail": "On Android, a 10ms vibration on landing and 20ms on the lid pop (navigator.vibrate), only while sound is on."
  }
 ]
